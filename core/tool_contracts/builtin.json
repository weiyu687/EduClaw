  {
    "name": "profile_csv",
    "description": "读取 CSV 并分析数据质量：row_count、columns、missing（每列空值数量）、duplicate_rows（完全重复行）、numeric（每列十进制数count/min/max/sum/mean）。数值统计返回字符串，非数值与科学计数法不参与。与 extract_csv 相同的文件读取边界；不执行单元格公式。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "csv_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "csv_path"
      ],
      "additionalProperties": false
    },
    "version": "1.0.0",
    "sdk_version": 1,
    "adapter": "profile_csv",
    "risk": "path_read",
    "resource_argument": "csv_path",
    "plannable": true,
    "extensions": [],
    "output_encoding": "json",
    "output_schema": {
      "type": "object",
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "duplicate_rows": {
          "type": "integer",
          "minimum": 0
        },
        "numeric": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "min": {
                "type": "string"
              },
              "max": {
                "type": "string"
              },
              "sum": {
                "type": "string"
              },
              "mean": {
                "type": "string"
              }
            },
            "required": [
              "count",
              "min",
              "max",
              "sum",
              "mean"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "row_count",
        "columns",
        "missing",
        "duplicate_rows",
        "numeric"
      ],
      "additionalProperties": false
    },
    "max_output_bytes": 2000000
  },
