  {
    "name": "extract_csv",
    "description": "读取 UTF-8 CSV，返回 columns 字符串数组、rows 对象数组和 row_count。单元格均为字符串，不执行公式；最多 10000 行、100 列、1 MiB 文件。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "csv_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "csv_path"
      ],
      "additionalProperties": false
    },
    "version": "1.0.0",
    "sdk_version": 1,
    "adapter": "extract_csv",
    "risk": "path_read",
    "resource_argument": "csv_path",
    "plannable": true,
    "extensions": [
      "csv"
    ],
    "output_encoding": "json",
    "output_schema": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "columns",
        "rows",
        "row_count"
      ],
      "additionalProperties": false
    },
    "max_output_bytes": 2000000
  }
